---
import Button from './Button.astro';
import { footerNav, footerConnect, contacts, brand, topics } from '../data/site.js';
const year = new Date().getFullYear();
const { lead = 'Your next opportunity could start here.' } = Astro.props;
---
<footer class="foot" data-theme="dark" data-nav-theme="dark">
  <div class="wrap">
    <div class="foot__top">
      <div class="foot__lead">
        <span class="label">Your move</span>
        <h2 class="h3" data-reveal="lines">{lead}</h2>
        <p class="body">
          You may be looking for a university. A scholarship. A research opportunity. A mentor. A community. Or simply a place to begin. Whatever your next step is, AcademiQ is here to help you find the people, knowledge and opportunities that can move you forward.
        </p>
        <p class="mono accent" style="margin-top:0.5rem;font-size:0.9rem">
          Learn. Connect. Discover. Contribute.
        </p>
        <div style="display:flex;flex-wrap:wrap;gap:.75rem;margin-top:1.25rem">
          <Button href="#apply" label="Join AcademiQ" />
          <Button href="#opportunities" label="Explore Opportunities" variant="ghost" />
        </div>
      </div>

      <div class="foot__cols">
        <div class="foot__col">
          <h3 class="mono">Navigate</h3>
          <ul>
            {footerNav.map((item) => (
              <li><a class="link link--quiet" href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </div>

        <div class="foot__col">
          <h3 class="mono">Connect</h3>
          <ul>
            {footerConnect.map((item) => (
              <li><a class="link link--quiet" href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </div>

        <div class="foot__col">
          <h3 class="mono">AcademIQ</h3>
          <p class="small" style="line-height:1.6;color:var(--fg-2)">
            Building a connected academic ecosystem for knowledge, opportunity and collaboration.
          </p>
          <div style="margin-top:1.5rem">
            <h4 class="mono" style="font-size:0.75rem;text-transform:uppercase;color:var(--fg-3);margin-bottom:0.5rem">Focus Areas</h4>
            <p class="small" style="color:var(--fg-2);line-height:1.5">
              {topics.join(' · ')}
            </p>
          </div>
        </div>

        <div class="foot__col foot__col--wide">
          <h3 class="mono">Connecting Minds. Creating Opportunities.</h3>
          <p class="small" style="color:var(--fg-2);line-height:1.6">
            AcademIQ is a growing global academic ecosystem connecting students, researchers, scholars, mentors and institutions through education, research, mentorship and meaningful opportunities.
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="foot__mark" aria-hidden="true" data-foot-mark>
    <span class="foot__mark-box">AQ</span>
    <span class="foot__mark-rest">
      {'ADEMIQ'.split('').map((c) => <span data-foot-char>{c}</span>)}
    </span>
  </div>

  <div class="wrap">
    <div class="foot__base mono">
      <span>© 2026 AcademiQ. All rights reserved.</span>
      <span class="foot__clock">Global <b data-clock>--:--:--</b> UTC</span>
      <ul>
        <li><a href="#privacy">Privacy Policy</a></li>
        <li><a href="#terms">Terms of Use</a></li>
        <li><a href="#guidelines">Community Guidelines</a></li>
      </ul>
      <a class="totop" href="#top" data-totop data-cursor="link">
        Back to top
        <svg viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M6 11V1M1.5 5.5 6 1l4.5 4.5" stroke="currentColor" stroke-width="1.5" /></svg>
      </a>
    </div>
  </div>
</footer>
