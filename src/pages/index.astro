---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Arrow from '../components/Arrow.astro';
import Marquee from '../components/Marquee.astro';
import SectionHead from '../components/SectionHead.astro';
import ApplyForm from '../components/ApplyForm.astro';
import '../styles/blocks.css';
import '../styles/pages/home.css';

import { stats, hubs, contacts, award, inr, topics } from '../data/site.js';
import { courses } from '../data/courses.js';
import { alumni, qualifications, placeNames, initials } from '../data/alumni.js';
import {
  phases,
  principles,
  teamDivisions,
  networkGroups,
  collaborationCategories,
  opportunityCategories,
  resourceCategories,
} from '../data/program.js';

const nonItCount = Math.floor((stats.learners * stats.nonIt) / 100);
const itCount = stats.learners - nonItCount;

// cumulative month positions for the journey ruler
let acc = 0;
const timeline = phases.map((p) => {
  const from = acc;
  acc += p.months;
  return { ...p, from, to: acc };
});

// hub constellation: real relative positions, projected into a 100 × 100 box
const lats = hubs.map((h) => h.lat);
const lons = hubs.map((h) => h.lon);
const span = Math.max(Math.max(...lats) - Math.min(...lats), Math.max(...lons) - Math.min(...lons));
const map = hubs.map((h) => ({
  ...h,
  px: 14 + ((h.lon - Math.min(...lons)) / span) * 72 + (72 - ((Math.max(...lons) - Math.min(...lons)) / span) * 72) / 2,
  py: 14 + ((Math.max(...lats) - h.lat) / span) * 72,
}));
---

<Base page="home" suffix="ADEMIQ" scene="home">
  <!-- ══════════════════════════════════════════════════════════ HERO ══════════════════════════════════════════════════════════ -->
  <section class="hero section--clear" data-theme="dark" data-stop="hero">
    <div class="wrap hero__inner">
      <div class="hero__top mono" data-hero-fade>
        <span class="hero__status"><span class="dot"></span>Connecting Minds. Creating Opportunities.</span>
        <span class="hero__award">EST. 2025 — GROWING GLOBALLY</span>
      </div>

      <div class="hero__mid" aria-hidden="true"></div>

      <h1 class="hero__title" aria-label="Connecting Minds. Creating Opportunities.">
        <span class="hero__row" aria-hidden="true">
          <span class="bw" data-pre-target data-hero-word>
            <span class="bw__box">AC</span><span class="bw__rest">ADEMIQ</span>
          </span>
        </span>
        <span class="hero__row hero__row--b" aria-hidden="true">
          <span class="hero__mask"><span data-hero-line>CONNECTING</span></span>
          <span class="hero__mask hero__mask--serif"><span class="serif accent" data-hero-line>minds.</span></span>
          <span class="hero__mask"><span data-hero-line>CREATING.</span></span>
        </span>
      </h1>

      <div class="hero__foot">
        <p class="hero__lead lead" data-hero-fade>
          AcademIQ is a growing global academic ecosystem connecting students, researchers, scholars, mentors and institutions through
          education, research, mentorship and <strong>meaningful opportunities.</strong>
        </p>

        <div class="hero__cta" data-hero-fade>
          <Button href="#apply" label="Join AcademiQ" size="lg" />
          <Button href="#who-we-are" label="Explore AcademiQ" variant="ghost" size="lg" />
        </div>

        <ul class="hero__facts" data-hero-fade>
          <li><b>{inr(stats.learners)}+</b><span class="mono">learners</span></li>
          <li><b>{stats.institutions}+</b><span class="mono">institutions</span></li>
          <li><b>{stats.countries}+</b><span class="mono">countries</span></li>
        </ul>
      </div>
    </div>

    <div class="pin" data-pin aria-hidden="true">
      <i class="pin__line"></i>
      <div class="pin__text mono">
        <b>AcademIQ Global</b>
        <span>28.61° N • 77.20° E</span>
        <span class="accent">→ connected in 30+ countries</span>
      </div>
    </div>

    <div class="hero__ticker" data-hero-fade>
      <Marquee speed={62} class="ticker" data-pause>
        {['EDUCATION', 'RESEARCH', 'OPPORTUNITIES', 'INTERNATIONAL AFFAIRS', 'YOUTH', 'KNOWLEDGE SHARING', 'MENTORSHIP'].map((topic) => (
          <span class="mq__item ticker__item">
            <span class="ticker__name">{topic}</span>
            <span class="ticker__arrow" aria-hidden="true"><Arrow dir="e" /></span>
            <span class="ticker__co">AcademIQ</span>
            <span class="ticker__lpa">Global</span>
          </span>
        ))}
      </Marquee>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════ 01 WHO WE ARE ══════════════════════════════════════════════════════════ -->
  <section class="mani section section--clear" data-theme="dark" data-stop="dust" id="who-we-are">
    <div class="wrap mani__grid">
      <div class="mani__label">
        <span class="label"><span class="label__no">01</span> Who we are</span>
      </div>

      <p class="mani__text" data-scrub-words>
        More than a community. An ecosystem. Where learning, research, mentorship and opportunity reinforce one another.
        <em>Talent should not be limited by geography, background or access.</em>
      </p>

      <div class="mani__aside">
        <p class="body" data-reveal="up">
          AcademIQ brings together students, young researchers, scholars, mentors and institutions in one connected space — where learning, research, mentorship and opportunity reinforce one another.
        </p>
        <p class="body" data-reveal="up" style="margin-top:0.75rem">
          We believe talent should not be limited by geography, background or access. Every curious mind deserves access to knowledge, guidance, meaningful connections and opportunities to grow. AcademiQ is building a culture of academic curiosity, collaboration and integrity — creating pathways for people to learn, contribute and connect with the wider world.
        </p>
        <div data-reveal="up" style="margin-top:1.25rem">
          <Button href="#what-we-do" label="Explore Six Pillars" variant="ghost" />
        </div>
      </div>
    </div>

    <div class="mani__from">
      <div class="wrap mani__from-head">
        <span class="mono dim">The AcademIQ Community — learning, researching, discussing and building together</span>
        <span class="mono dim">EST. 2025 • GROWING GLOBALLY</span>
      </div>
      <Marquee speed={90} class="quals">
        {qualifications.map((q) => (
          <span class="mq__item quals__item"><span>{q}</span><i aria-hidden="true">→</i></span>
        ))}
      </Marquee>
      <Marquee speed={70} dir={1} class="quals quals--b">
        {['Higher Education', 'Research', 'Academic Development', 'Opportunities', 'Mentorship & Networking', 'Global Engagement'].map((q) => (
          <span class="mq__item quals__item"><span>{q}</span><i aria-hidden="true">•</i></span>
        ))}
      </Marquee>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════ 02 OUR REACH ══════════════════════════════════════════════════════════ -->
  <section class="nums section" data-theme="paper" id="reach">
    <div class="wrap">
      <SectionHead no="02" label="Our reach" meta="*Figures will be updated as our community and programmes grow.*">
        <Fragment slot="title">A network in<br /><span class="serif accent">motion.</span></Fragment>
        <p class="body" data-reveal="up">
          AcademIQ is growing through people, ideas and collaborations.
        </p>
      </SectionHead>

      <div class="nums__grid">
        <article class="num num--hero card" data-reveal="up">
          <header class="num__top mono"><span>01</span><span>Students</span></header>
          <p class="num__value"><span data-odo={inr(stats.learners)}>{inr(stats.learners)}</span><span class="num__unit num__unit--after">+</span></p>
          <footer class="num__foot">
            <h3 class="h4">Students</h3>
            <p class="small">Curious minds beginning their academic journey.</p>
          </footer>
          <figure class="dots" data-cursor="none">
            <canvas data-dots data-count={stats.learners} data-share={stats.nonIt / 100} aria-hidden="true"></canvas>
            <figcaption class="mono">
              <span>One dot, one aspiring mind</span>
              <span><i class="dots__key dots__key--a"></i>Students <i class="dots__key dots__key--b"></i>Scholars</span>
            </figcaption>
          </figure>
        </article>

        <article class="num card" data-reveal="up" data-tilt="4">
          <header class="num__top mono"><span>02</span><span>Researchers</span></header>
          <p class="num__value"><span>Active</span></p>
          <footer class="num__foot">
            <h3 class="h4">Young Researchers</h3>
            <p class="small">Young researchers exploring questions that matter.</p>
          </footer>
        </article>

        <article class="num card" data-reveal="up" data-tilt="4">
          <header class="num__top mono"><span>03</span><span>Scholars &amp; Academics</span></header>
          <p class="num__value"><span>Global</span></p>
          <footer class="num__foot">
            <h3 class="h4">Scholars &amp; Academics</h3>
            <p class="small">Experienced voices sharing knowledge and perspective.</p>
          </footer>
        </article>

        <article class="num num--red card" data-theme="red" data-reveal="up" data-tilt="3">
          <header class="num__top mono"><span>04</span><span>Mentors</span></header>
          <p class="num__value"><span>1:1</span></p>
          <footer class="num__foot">
            <h3 class="h4">Mentors</h3>
            <p class="small">People helping others navigate academic and professional pathways.</p>
          </footer>
        </article>

        <article class="num card" data-reveal="up" data-tilt="4">
          <header class="num__top mono"><span>05</span><span>Institutions</span></header>
          <p class="num__value"><span data-odo={String(stats.institutions)}>{stats.institutions}</span><span class="num__unit num__unit--after">+</span></p>
          <footer class="num__foot">
            <h3 class="h4">Institutions</h3>
            <p class="small">Universities, organisations and communities working together.</p>
          </footer>
        </article>

        <article class="num card" data-reveal="up" data-tilt="4">
          <header class="num__top mono"><span>06</span><span>Global Connections</span></header>
          <p class="num__value"><span data-odo={String(stats.countries)}>{stats.countries}</span><span class="num__unit num__unit--after">+</span></p>
          <footer class="num__foot">
            <h3 class="h4">Global Connections</h3>
            <p class="small">Building bridges between people, ideas and opportunities across borders.</p>
          </footer>
        </article>
      </div>

      <div class="nums__more" data-reveal="up">
        <Button href="#apply" label="Join our growing network" variant="light" />
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════ 03 OUR STORY ══════════════════════════════════════════════════════════ -->
  <section class="pap section section--clear" data-theme="dark" data-stop="rupee" id="story">
    <div class="wrap pap__grid">
      <header class="pap__head">
        <span class="label"><span class="label__no">03</span> Our story</span>
        <h2 class="h1 pap__title" data-reveal="lines">Building an ecosystem around <span class="serif accent">knowledge &amp; opportunity.</span></h2>
      </header>

      <div class="pap__body">
        <p class="lead" data-reveal="up">
          Across the world, talented students and researchers often face the same challenge: not a lack of ability, but a lack of access.
        </p>

        <ol class="pap__steps">
          <li class="pap__step" data-reveal="up">
            <span class="mono accent">01</span>
            <h3 class="h4">The Challenge</h3>
            <p class="small">Access to guidance. Access to opportunities. Access to mentors. Access to research communities. Access to people who can open new doors.</p>
          </li>
          <li class="pap__step" data-reveal="up">
            <span class="mono accent">02</span>
            <h3 class="h4">Why AcademiQ</h3>
            <p class="small">Information is everywhere, but meaningful academic pathways are often scattered and difficult to navigate. AcademiQ was created to help change that.</p>
          </li>
          <li class="pap__step" data-reveal="up">
            <span class="mono accent">03</span>
            <h3 class="h4">Our Goal</h3>
            <p class="small">Make knowledge more accessible. Make opportunities easier to discover. Make academic communities more connected.</p>
          </li>
        </ol>

        <div class="pap__guard" data-reveal="up">
          <div class="stamp" aria-hidden="true" data-stamp>
            <svg viewBox="0 0 200 200">
              <defs><path id="stamp-path" d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0" /></defs>
              <text><textPath href="#stamp-path" textLength="482" lengthAdjust="spacing">ACADEMIQ • GLOBAL ECOSYSTEM • EST. 2025 • CONNECTING MINDS •</textPath></text>
            </svg>
            <b>AQ</b>
          </div>
          <div>
            <h3 class="h4">Mission &amp; Vision</h3>
            <p class="small">
              <strong>Mission:</strong> To create an accessible and collaborative ecosystem where students and researchers can learn, connect, discover opportunities and develop the skills needed to contribute meaningfully to academia and society.<br /><br />
              <strong>Vision:</strong> To grow into a globally connected academic ecosystem where knowledge, people and opportunities move freely across borders.
            </p>
          </div>
        </div>

        <div class="pap__cta" data-reveal="up">
          <Button href="#apply" label="Join AcademiQ" />
          <Button href="#what-we-do" label="Explore What We Do" variant="ghost" />
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════ 04 WHAT WE DO ══════════════════════════════════════════════════════════ -->
  <section class="dom section" data-theme="dark" id="what-we-do">
    <div class="wrap">
      <SectionHead no="04" label="What we do" meta="Six pillars · One ecosystem">
        <Fragment slot="title">Six pillars.<br /><span class="serif accent">One ecosystem.</span></Fragment>
        <p class="body" data-reveal="up">
          AcademIQ connects different parts of the academic journey — from learning and research to opportunities, mentorship and global engagement.
        </p>
      </SectionHead>

      <ul class="dom__list" data-domains>
        {courses.map((c) => (
          <li class="dom__item" data-reveal="up">
            <a class="dom__row" href="#apply" data-cursor="view" data-domain data-glyph={c.glyph} data-line={c.line} data-family={c.family}>
              <span class="dom__no mono">{c.no}</span>
              <span class="dom__name">{c.name}</span>
              <span class="dom__stacks mono">
                {(c.stacks.length ? c.stacks : ['Core Pillar']).slice(0, 4).join(' • ')}
              </span>
              <span class="dom__arrow" aria-hidden="true"><Arrow /></span>
            </a>
          </li>
        ))}
      </ul>

      <div class="dom__more" data-reveal="up">
        <Button href="#apply" label="Get Involved" variant="ghost" />
      </div>
    </div>

    <div class="peek" data-domain-peek aria-hidden="true">
      <div class="peek__card">
        <span class="peek__family mono" data-peek-family>Pillar</span>
        <span class="peek__glyph" data-peek-glyph>🎓</span>
        <p class="peek__line" data-peek-line></p>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════ 05 OUR INITIATIVES ══════════════════════════════════════════════════════════ -->
  <section class="world section--clear" data-theme="dark" data-stop="world" id="initiatives">
    <div class="wrap world__inner">
      <div class="world__copy">
        <span class="label"><span class="label__no">05</span> Our initiatives</span>
        <h2 class="h1 world__title" data-reveal="lines">Turning ideas into <span class="serif accent">initiatives.</span></h2>
        <p class="lead" data-reveal="up">
          AcademIQ transforms ideas into programmes, conversations and experiences designed to create meaningful academic and social impact.
        </p>
        <p class="body" data-reveal="up">
          From workshops and research initiatives to youth programmes, academic discussions and collaborative projects, our initiatives are built around one principle:<br /><br />
          <strong style="color:var(--fg);font-size:1.15rem">Create something useful. Connect people who can make it stronger.</strong>
        </p>
        <p class="mono dim" data-reveal="up" style="margin-top:0.75rem">
          *Upcoming Initiatives: New programmes and initiatives are currently being developed.
        </p>
        <div data-reveal="up" style="margin-top:1.5rem">
          <Button href="#apply" label="Explore Initiatives" />
        </div>
      </div>
    </div>

    <Marquee speed={80} class="places">
      {['Workshops', 'Research Initiatives', 'Youth Programmes', 'Academic Discussions', 'Collaborative Projects', 'Knowledge Sessions', 'Global Dialogues'].map((p) => (
        <span class="mq__item places__item"><span>{p}</span><i aria-hidden="true">•</i></span>
      ))}
    </Marquee>
  </section>

  <!-- ══════════════════════════════════════════════════════════ 06 OUR JOURNEY ══════════════════════════════════════════════════════════ -->
  <section class="jour" data-theme="paper" data-journey id="journey">
    <div class="jour__pin" data-journey-pin>
      <header class="wrap jour__head">
        <div class="jour__head-l">
          <span class="label"><span class="label__no">06</span> Our journey</span>
          <h2 class="h2" data-reveal="lines">From an idea to a <span class="serif accent">growing ecosystem.</span></h2>
        </div>
        <div class="jour__meter mono" aria-hidden="true">
          <span>Phase</span>
          <b data-journey-month>01</b>
          <span>/ 06</span>
        </div>
      </header>

      <div class="jour__track-wrap">
        <ol class="jour__track" data-journey-track>
          {phases.map((p, i) => (
            <li class="jour__card card" data-phase={i} style={`--dur:${p.months}`}>
              <header class="jour__card-head mono">
                <span class="jour__no">{p.no}</span>
                <span class="jour__dur">{p.duration}</span>
                <span class="jour__verb">{p.verb}</span>
              </header>

              <h3 class="jour__name h3">{p.name}</h3>

              <div class="term" aria-hidden="true">
                <div class="term__bar mono"><span>step_{p.no}.sh</span><i></i></div>
                <pre class="term__body mono">{p.code.join('\n')}</pre>
              </div>

              <p class="jour__text body">{p.text}</p>
              <p class="jour__out mono">→ {p.out}</p>
            </li>
          ))}

          <li class="jour__card jour__card--end card" data-phase={phases.length}>
            <header class="jour__card-head mono">
              <span class="jour__no">07</span>
              <span class="jour__dur">Next Chapter</span>
              <span class="jour__verb">Lead</span>
            </header>
            <h3 class="jour__name h3">Growing Globally.</h3>
            <div class="jour__end-body">
              <p class="lead">Building stronger partnerships, expanding programmes and connecting more people across borders.</p>
              <p class="body">Connecting minds, opening pathways, and elevating scholarship across every corner of the globe.</p>
            </div>
            <Button href="#apply" label="Join our journey" variant="light" />
          </li>
        </ol>
      </div>

      <div class="wrap jour__ruler" aria-hidden="true">
        <div class="ruler" data-journey-ruler>
          {timeline.map((p) => (
            <span class="ruler__seg" style={`--from:${p.from / 12};--len:${p.months / 12}`} data-ruler-seg>
              <em class="mono">{p.name}</em>
            </span>
          ))}
          <span class="ruler__seg ruler__seg--end" style={`--from:${acc / 12};--len:${(12 - acc) / 12}`} data-ruler-seg>
            <em class="mono">Growing Globally</em>
          </span>
          <i class="ruler__fill" data-journey-fill></i>
          <i class="ruler__dot" data-journey-dot></i>
        </div>
        <div class="ruler__ticks mono">
          {Array.from({ length: 13 }).map((_, i) => <span>{String(i).padStart(2, '0')}</span>)}
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════ 07 WHAT WE STAND FOR ══════════════════════════════════════════════════════════ -->
  <section class="prin" data-theme="dark" data-principles id="what-we-stand-for">
    <div class="wrap prin__head">
      <span class="label"><span class="label__no">07</span> What we stand for</span>
      <h2 class="h2" data-reveal="lines">Six commitments of <span class="serif accent">AcademIQ.</span></h2>
    </div>

    <div class="prin__stack">
      {principles.map((p, i) => (
        <article class="rule-card" data-rule-card data-theme={['paper', 'red', 'dark', 'paper', 'red', 'dark'][i % 3]} style={`--i:${i}`}>
          <div class="wrap rule-card__inner">
            <header class="rule-card__top mono">
              <span>Commitment {p.no}</span>
              <span>{p.badge}</span>
            </header>
            <h3 class="rule-card__title">{p.title}</h3>
            <div class="rule-card__foot">
              <p class="lead">{p.text}</p>
              <span class="rule-card__no" aria-hidden="true">{p.no}</span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════ 08 MEET THE FOUNDERS ══════════════════════════════════════════════════════════ -->
  <section class="note section" data-theme="dark" id="founders">
    <div class="wrap note__grid">
      <div class="note__label">
        <span class="label"><span class="label__no">08</span> Meet the founders</span>
      </div>
      <blockquote class="note__quote">
        <p data-reveal="lines">
          Built by people who believe knowledge shared is <span class="serif accent">knowledge multiplied.</span>
        </p>
      </blockquote>
      <div class="note__foot" data-reveal="up">
        <div>
          <p class="h4">The AcademiQ Team</p>
          <p class="body" style="margin-top:0.5rem;color:var(--fg-2)">
            AcademIQ is being built by people who believe that education becomes more powerful when knowledge is shared and opportunities are opened for others. Our founders bring together different perspectives, experiences and ambitions with one common goal: To build an academic ecosystem that creates meaningful possibilities for the next generation.
          </p>
          <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(200px, 1fr));gap:0.75rem;margin-top:1.25rem">
            {teamDivisions.map((t) => (
              <div style="padding:0.75rem;border:1px solid var(--rule);background:rgba(255,255,255,0.03);border-radius:6px">
                <strong class="mono accent" style="display:block;font-size:0.85rem">{t.role}</strong>
                <span class="small" style="color:var(--fg-2);font-size:0.75rem">{t.desc}</span>
              </div>
            ))}
          </div>
        </div>
        <div style="align-self:start">
          <a class="note__mail" href={`mailto:${contacts.ceo.email}`} data-copy={contacts.ceo.email} data-copy-done="Email copied" data-cursor="copy">
            <span>{contacts.ceo.email}</span>
            <span class="orb" aria-hidden="true"><Arrow /></span>
          </a>
          <p class="small" style="margin-top:0.75rem">We read every message personally and respond to scholars and partners.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════ 09 OPPORTUNITIES ══════════════════════════════════════════════════════════ -->
  <section class="section" data-theme="paper" id="opportunities" style="border-top:1px solid var(--rule);padding:var(--section) 0">
    <div class="wrap">
      <SectionHead no="09" label="Opportunities" meta="Curating &amp; Verifying · Coming Soon">
        <Fragment slot="title">Discover your next <span class="serif accent">opportunity.</span></Fragment>
        <p class="body" data-reveal="up">
          The right opportunity can change the direction of an academic journey. AcademiQ brings together opportunities from across the academic ecosystem and makes them easier to discover.
        </p>
      </SectionHead>

      <div style="display:flex;flex-wrap:wrap;gap:0.5rem;margin:2rem 0" data-reveal="up">
        {opportunityCategories.map((cat, i) => (
          <span class="tag" style={i === 0 ? "background:var(--accent);color:#fff" : ""}>{cat}</span>
        ))}
      </div>

      <div class="card" style="padding:clamp(1.5rem, 2.5vw, 3rem);background:var(--paper-2);border:1px solid var(--rule);border-radius:12px;margin-top:1.5rem" data-reveal="up">
        <div style="max-width:48rem">
          <span class="mono accent" style="font-size:0.8rem;letter-spacing:0.1em;text-transform:uppercase">Curating &amp; Verifying</span>
          <h3 class="h3" style="margin:0.5rem 0 1rem">Coming Soon</h3>
          <p class="body" style="color:var(--fg-2);line-height:1.6">
            Our team is currently curating and verifying opportunities before publishing them. We believe quality matters more than quantity. Every opportunity should provide clear and useful information so that students and researchers can make informed decisions.
          </p>
          <div style="display:flex;align-items:center;gap:1.5rem;flex-wrap:wrap;margin-top:1.5rem">
            <Button href="#apply" label="Join AcademiQ" />
            <span class="small mono" style="color:var(--fg-3)">Be among the first to know when new opportunities go live.</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════ 10 EVENTS ══════════════════════════════════════════════════════════ -->
  <section class="section" data-theme="dark" id="events" style="border-top:1px solid var(--rule);padding:var(--section) 0">
    <div class="wrap">
      <SectionHead no="10" label="Events" meta="Talks · Workshops · Discussions">
        <Fragment slot="title">Ideas become <span class="serif accent">conversations.</span></Fragment>
        <p class="body" data-reveal="up">
          Great ideas grow when people come together. AcademiQ brings students, researchers, scholars, mentors and experts together through talks, workshops, discussions and community sessions.
        </p>
      </SectionHead>

      <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(280px, 1fr));gap:var(--gap);margin-top:2.5rem" data-reveal="up">
        <div class="card" style="padding:2rem;background:rgba(255,255,255,0.02);border:1px solid var(--rule)">
          <span class="mono accent" style="font-size:0.8rem">UPCOMING SESSIONS</span>
          <h3 class="h4" style="margin:0.75rem 0">Upcoming Events</h3>
          <p class="small" style="color:var(--fg-2);line-height:1.6">
            New conversations are being planned.
          </p>
          <div style="margin-top:1.5rem">
            <Button href="#apply" label="Explore Events" variant="ghost" size="sm" />
          </div>
        </div>

        <div class="card" style="padding:2rem;background:rgba(255,255,255,0.02);border:1px solid var(--rule)">
          <span class="mono dim" style="font-size:0.8rem">COMMUNITY ARCHIVE</span>
          <h3 class="h4" style="margin:0.75rem 0">Past Events</h3>
          <p class="small" style="color:var(--fg-2);line-height:1.6">
            Explore conversations and activities from the AcademiQ community.
          </p>
          <div style="margin-top:1.5rem">
            <Button href="#apply" label="View Past Events" variant="ghost" size="sm" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════ 11 COMMUNITY ══════════════════════════════════════════════════════════ -->
  <section class="alum section" data-theme="dark" id="community">
    <div class="wrap">
      <SectionHead no="11" label="Community" meta="Be part of the community">
        <Fragment slot="title">A growing circle of curious, <span class="serif accent">ambitious minds.</span></Fragment>
        <p class="body" data-reveal="up">
          AcademIQ is its people. A growing circle of curious, ambitious minds learning from one another, sharing knowledge and creating opportunities together.
        </p>
      </SectionHead>
    </div>

    <div class="rail" data-rail data-cursor="drag">
      <ul class="rail__track" data-rail-track>
        {networkGroups.map((g, i) => (
          <li class="person card" data-person>
            <header class="person__top">
              <span class="person__mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="mono dimmer">Community</span>
            </header>
            <p class="person__lpa"><b>{g.role}</b><span class="mono"> • AcademiQ</span></p>
            <footer class="person__foot">
              <h3 class="h4">{g.role}</h3>
              <p class="small">{g.desc}</p>
            </footer>
          </li>
        ))}
        <li class="person person--more" data-person>
          <a href="#apply" data-cursor="view">
            <span class="mono">Your people are out there</span>
            <span class="h3">Join AcademiQ</span>
            <span class="orb"><Arrow /></span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════ 12 COLLABORATE & PARTNERS ══════════════════════════════════════════════════════════ -->
  <section class="hubs section" data-theme="paper" data-hubs id="collaborate">
    <div class="wrap">
      <SectionHead no="12" label="Collaborate" meta="Let's build something together">
        <Fragment slot="title">Let's build <span class="serif accent">something together.</span></Fragment>
        <p class="body" data-reveal="up">
          AcademIQ grows through meaningful collaboration. Whether you represent a university, research group, educational organisation, youth organisation or your own professional expertise, there is a way to contribute. We welcome collaborations that create genuine educational, research and social value.
        </p>
      </SectionHead>

      <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(260px, 1fr));gap:var(--gap);margin-top:2.5rem" data-reveal="up">
        {collaborationCategories.map((c) => (
          <div class="card" style="padding:1.5rem;background:var(--paper-2);border:1px solid var(--rule)">
            <h3 class="h4" style="margin-bottom:0.5rem">{c.name}</h3>
            <p class="small" style="color:var(--fg-2);line-height:1.5">{c.desc}</p>
          </div>
        ))}
      </div>

      <div style="margin-top:3.5rem;padding-top:2.5rem;border-top:1px solid var(--rule)" data-reveal="up" id="partners">
        <div style="display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:1.5rem">
          <div>
            <span class="label"><span class="label__no">12b</span> Partners</span>
            <h3 class="h3" style="margin-top:0.5rem">Built through collaboration.</h3>
            <p class="body" style="color:var(--fg-2);margin-top:0.5rem;max-width:44rem">
              AcademIQ believes meaningful change rarely happens alone. Our partnerships bring together institutions, organisations, researchers, educators and communities working toward shared goals.
            </p>
            <p class="small mono" style="color:var(--fg-3);margin-top:0.5rem">
              *Verified partners and collaborators will be featured here as collaborations are formally established.
            </p>
          </div>
          <Button href={`mailto:${contacts.official.email}`} label="Start a conversation" />
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════ 13 RESOURCES ══════════════════════════════════════════════════════════ -->
  <section class="section" data-theme="dark" id="resources" style="border-top:1px solid var(--rule);padding:var(--section) 0">
    <div class="wrap">
      <SectionHead no="13" label="Resources" meta="Coming Soon · Quality resources">
        <Fragment slot="title">Knowledge you <span class="serif accent">can use.</span></Fragment>
        <p class="body" data-reveal="up">
          Good academic work begins with good resources. AcademiQ is building a growing library of practical resources for students, researchers and academics. Every resource will be reviewed before publication.
        </p>
      </SectionHead>

      <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(260px, 1fr));gap:var(--gap);margin-top:2.5rem" data-reveal="up">
        {resourceCategories.map((r) => (
          <div class="card" style="padding:1.5rem;background:rgba(255,255,255,0.02);border:1px solid var(--rule)">
            <span class="mono accent" style="font-size:0.72rem;letter-spacing:0.1em;text-transform:uppercase">COMING SOON</span>
            <h3 class="h4" style="margin:0.5rem 0">{r.name}</h3>
            <p class="small" style="color:var(--fg-2);line-height:1.5">{r.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════ 14 YOUR MOVE ══════════════════════════════════════════════════════════ -->
  <section class="join section" data-theme="red" id="apply">
    <div class="wrap join__grid">
      <header class="join__head">
        <span class="label label--plain"><span class="dot" style="background:#fff"></span> 14 Your move</span>
        <h2 class="display join__title" data-reveal="chars">Ready to<br />join?</h2>
        <p class="lead" data-reveal="up">
          Your next opportunity could start here. You may be looking for a university. A scholarship. A research opportunity. A mentor. A community. Or simply a place to begin. Whatever your next step is, AcademiQ is here to help you find the people, knowledge and opportunities that can move you forward.
        </p>
        <p class="mono" style="margin-top:1rem;color:rgba(255,255,255,0.9);font-size:0.95rem">
          Learn. Connect. Discover. Contribute.
        </p>
      </header>

      <div class="join__form" data-reveal="up">
        <ApplyForm id="home-apply" />
      </div>
    </div>
  </section>
</Base>
